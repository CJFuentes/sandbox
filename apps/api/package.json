{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
