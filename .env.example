# Environment variables the app reads (all optional; the defaults are shown).
# The app reads them from the process environment; it does not load this file.

# API (apps/api)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
PORT=3000
HOST=127.0.0.1
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
LOG_LEVEL=info

# Web (apps/web): Vite dev and preview server
WEB_PORT=5173
# Where the web server proxies /api requests (also the API base URL for tests)
API_URL=http://localhost:3000

# End-to-end tests (apps/web/e2e)
WEB_URL=http://localhost:5173
